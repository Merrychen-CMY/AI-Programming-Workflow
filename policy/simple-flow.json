{
  "schema_version": 1,
  "workflow_version": "3.20.2",
  "default_mode": "simple",
  "execution_authority": false,
  "user_facing_roles": [
    "L1"
  ],
  "entry_documents": [
    "AGENTS.md",
    "L1.md",
    "DOT.md",
    "templates/requirements.md"
  ],
  "user_approval_artifact": "l1_final_success_or_failure_report",
  "implementation_requires_user_approval": false,
  "routine_in_scope_work_requires_new_user_approval": false,
  "internal_verification_plan_requires_separate_user_document": false,
  "internal_role_mapping": {
    "L1": "sole_user_interface_requirements_and_delegated_approval_final_report",
    "L1-V": "L1_internal_independent_verification_planning",
    "L2": "DOT_orchestration",
    "L3": "implementation_worker",
    "L4": "independent_test_and_review_workers",
    "L5": "DOT_acceptance_and_delivery_request"
  },
  "independent_verification_required": true,
  "implementation_worker_can_issue_final_acceptance": false,
  "issue_intake": "DOT_as_L2",
  "direct_verifier_to_developer_dispatch": false,
  "product_or_ac_change_requires_user_decision": true,
  "plan_maintenance": {
    "within_explicit_delegation": "L1_approves_resource_allocations_and_increases_preserving_cumulative_usage",
    "semantic_change": "L1_reapproves_within_current_user_authority_and_reruns_required_checks",
    "may_lower_acceptance_standard": false,
    "outside_delegation": "L1_requests_explicit_native_user_amendment_or_submits_final_report"
  },
  "delivery": {
    "execute_when_existing_authorization_covers_actual_action": true,
    "check_actual_candidate_evidence_action_target": true,
    "require_new_approval_when_scope_not_covered": true,
    "DOT_may_self_authorize": false,
    "preauthorization_must_bind": [
      "actions",
      "targets",
      "candidate_conditions",
      "evidence_conditions",
      "expiry",
      "use_limit"
    ],
    "requires_approved_success_report": true,
    "preauthorization_may_bypass_report_review": false,
    "local_runtime_executes_delivery": false,
    "delivered_requires_external_receipt": true
  },
  "three_checkpoints": [
    "approved_requirements",
    "approved_execution_plan",
    "approved_final_report"
  ],
  "user_decision_triggers": [
    "initial_missing_facts",
    "consolidated_start_confirmation",
    "explicit_authority_amendment_when_needed",
    "final_report"
  ],
  "user_visible_outputs": [
    "initial_requirements_questions",
    "consolidated_start_summary",
    "bounded_authorization_request_when_needed",
    "success_or_failure_final_report_for_review",
    "requirements_and_plan_markdown_review_reports_without_new_user_approval"
  ],
  "states": [
    {
      "id": "DISCOVERY",
      "next": [
        "REVIEW_PENDING"
      ],
      "guard": "Native onboarding completes model/key setup and basic environment checks before L1 gathers facts; project-specific checks and consolidated user startup confirmation precede autonomous execution; no product implementation during discovery"
    },
    {
      "id": "REVIEW_PENDING",
      "next": [
        "DISCOVERY",
        "PLAN_PENDING",
        "BLOCKED",
        "DECISION_PENDING",
        "REPORT_PENDING"
      ],
      "guard": "L1 delegated approval bound to original input, envelope, exact artifact and independent review; failure pauses for L2 solution analysis and L1 assessment; non-success finalization requires explicit L1 closure assessment; automatic errors pause for L2 solution analysis and L1 coordination"
    },
    {
      "id": "PLAN_PENDING",
      "next": [
        "REVIEW_PENDING",
        "EXECUTING",
        "BLOCKED",
        "DECISION_PENDING",
        "REPORT_PENDING"
      ],
      "guard": "L1 delegated approval bound to original input, envelope, exact artifact and independent review; failure pauses for L2 solution analysis and L1 assessment; non-success finalization requires explicit L1 closure assessment; automatic errors pause for L2 solution analysis and L1 coordination; new native initialization adopts the actual pre-plan requirements review without replay or counter reset"
    },
    {
      "id": "EXECUTING",
      "next": [
        "VERIFYING",
        "DECISION_PENDING",
        "REPORT_PENDING",
        "BLOCKED"
      ],
      "guard": "Approved baselines, bounded dispatch and cumulative usage; adaptive allocation exhaustion pauses for L1 evaluation before any new dispatch; non-success finalization requires explicit L1 closure assessment; automatic errors pause for L2 solution analysis and L1 coordination"
    },
    {
      "id": "VERIFYING",
      "next": [
        "EXECUTING",
        "DECISION_PENDING",
        "REPORT_PENDING",
        "BLOCKED"
      ],
      "guard": "Distinct developer tester reviewer sessions; immutable candidate and all required evidence; failures return DOT triage before bounded repair; non-success finalization requires explicit L1 closure assessment; automatic errors pause for L2 solution analysis and L1 coordination"
    },
    {
      "id": "DECISION_PENDING",
      "next": [
        "REVIEW_PENDING",
        "PLAN_PENDING",
        "EXECUTING",
        "VERIFYING",
        "REPORT_PENDING",
        "BLOCKED",
        "DECISION_PENDING"
      ],
      "guard": "L1 revises within current user authority; changes beyond authority require native user approval; reapprove affected baselines and preserve all counters; non-success finalization requires explicit L1 closure assessment; automatic errors pause for L2 solution analysis and L1 coordination; bounded read-only dot_investigate is permitted, l1_resume_decision validates existing approvals, evidence and resources before execution"
    },
    {
      "id": "BLOCKED",
      "next": [
        "REVIEW_PENDING",
        "PLAN_PENDING",
        "REPORT_PENDING"
      ],
      "guard": "No automatic resumption; reconcile old runs and side effects; changed scope or additional budget needs new approval; counters never reset"
    },
    {
      "id": "REPORT_PENDING",
      "next": [
        "DELIVERY_READY",
        "BLOCKED"
      ],
      "guard": "L1 submits exact DOT outcome/evidence and its assessment; only human approves final report; failed/unknown remains BLOCKED and never authorizes retries; every non-success report carries l1_closure_assessment recorded before finalization"
    },
    {
      "id": "DELIVERY_READY",
      "next": [
        "DELIVERED",
        "DECISION_PENDING",
        "BLOCKED"
      ],
      "guard": "Approved success report plus exact action and target authorization and external receipt required for DELIVERED; local runtime cannot deliver"
    },
    {
      "id": "DELIVERED",
      "next": [
        "DISCOVERY"
      ],
      "guard": "New request preserves prior reports approvals evidence and cumulative history"
    }
  ],
  "advanced_reference": "docs/advanced-profile.md",
  "existing_project_protections_remain_required": true,
  "runtime_implemented_by_this_repository": true,
  "applicable_coding_standards": [
    "policy/embedded-c.json"
  ],
  "coding_standard_requires_extra_user_document": false,
  "execution_plan_requires_user_approval": false,
  "final_report_requires_user_approval": true,
  "requirements_approval_allows_implementation": false,
  "independent_review_required": true,
  "distinct_worker_sessions": [
    "developer",
    "tester",
    "reviewer"
  ],
  "runtime_approval_trust_model": "local_delegated_l1_and_final_human_no_authenticated_service",
  "agent_may_enter_user_approval": false,
  "failed_report_approval_resumes_execution": false,
  "budgets_reset_on_restart_or_replan": false,
  "requirements_require_l1_approval": true,
  "execution_plan_requires_l1_approval": true,
  "product_or_ac_change_requires_l1_decision": true,
  "default_approval_mode": "delegated_l1",
  "approval_owners": {
    "requirements": "L1",
    "execution_plan": "L1",
    "final_report": "user"
  },
  "communication_policy": "policy/communication.json",
  "startup_confirmation_required": true,
  "onboarding_policy": "policy/onboarding.json",
  "planning_policy": "policy/planning.json",
  "clarification_policy": {
    "state": "NEEDS_INFO",
    "append_tool": "l1_add_facts",
    "original_confirmation_immutable": true,
    "same_task_supplements_allowed": true,
    "budget_reset_allowed": false,
    "expiry_extension_allowed": false,
    "requires_independent_baseline_review": true,
    "unknown_or_final_report_auto_resume": false,
    "guide": "docs/guides/clarifications.md"
  },
  "resource_policy": "policy/resources.json",
  "authority_change_requires_user_decision": true,
  "in_scope_requirement_clarification_requires_user_decision": false,
  "update_policy": "policy/updates.json",
  "task_upgrade_policy": "policy/task-upgrades.json",
  "task_upgrade_transitions": {
    "confirmed_nonterminal_quiescent": "native_review_then_rebind_runtime_and_invalidate_approvals_and_candidate",
    "existing_decision_pending": "preserve_decision_pending",
    "other_supported_runtime_states": "REVIEW_PENDING",
    "UNKNOWN_or_final": "reject",
    "incomplete_local_migration": "block_task_tools_until_exact_recorded_writes_finish"
  },
  "initialization_recovery_policy": "policy/initialization-recovery.json",
  "api_recovery_policy": "policy/api-recovery.json",
  "review_handoff_policy": "policy/review-handoff.json",
  "non_success_closure": {
    "schema_version": 1,
    "non_success_requires_explicit_l1_assessment": true,
    "l2_may_finalize_failure": false,
    "l2_first_considers_in_scope_solutions": true,
    "insufficient_evidence_is_terminal": false,
    "out_of_scope_proposal_owner": "L1",
    "automatic_non_success_route": "L1_assessment",
    "assessment_template": "templates/l1-closure.example.json",
    "guide": "docs/guides/l1-closure.md"
  },
  "flow_recovery_policy": "policy/flow-recovery.json",
  "requirements_approval_before_initial_dot_plan": true,
  "new_native_tasks_require_adaptive_limits": true,
  "preflight_requirements_states": [
    "REQUIREMENTS_PENDING",
    "REQUIREMENTS_APPROVED",
    "DECISION_PENDING"
  ],
  "execution_scope_policy": "policy/execution-scope.json",
  "candidate_verification": {
    "guide": "docs/guides/verification-contract.md",
    "require_test_contract": true,
    "require_actual_product_provenance": true,
    "required_test_skip_passes": false,
    "independent_test_artifacts": "isolated_writable_copy_with_immutable_inputs",
    "facility_actions": "L2_selects_baseline_approved_actions_or_requests_L1_review"
  },
  "agent_capability_policy": "policy/agent-capabilities.json",
  "file_environment_policy": "policy/file-environment.json",
  "input_material_policy": "policy/input-material.json",
  "blocker_recovery_guide": "docs/guides/execution-scope.md",
  "efficiency_guide": "docs/guides/workflow-efficiency.md"
}
