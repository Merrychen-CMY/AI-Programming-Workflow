{
  "schema_version": 1,
  "workflow_version": "3.0.2",
  "default_mode": "simple",
  "execution_authority": false,
  "user_facing_roles": [
    "L1"
  ],
  "entry_documents": [
    "AGENTS.md",
    "L1.md",
    "DOT.md",
    "templates/requirements.md"
  ],
  "user_approval_artifact": "l1_final_success_or_failure_report",
  "implementation_requires_user_approval": false,
  "routine_in_scope_work_requires_new_user_approval": false,
  "internal_verification_plan_requires_separate_user_document": false,
  "internal_role_mapping": {
    "L1": "sole_user_interface_requirements_and_delegated_approval_final_report",
    "L1-V": "L1_internal_independent_verification_planning",
    "L2": "DOT_orchestration",
    "L3": "implementation_worker",
    "L4": "independent_test_and_review_workers",
    "L5": "DOT_acceptance_and_delivery_request"
  },
  "independent_verification_required": true,
  "implementation_worker_can_issue_final_acceptance": false,
  "issue_intake": "DOT_as_L2",
  "direct_verifier_to_developer_dispatch": false,
  "product_or_ac_change_requires_user_decision": false,
  "plan_maintenance": {
    "within_explicit_delegation": "equivalent_maintenance_logged_without_changing_approved_scope_checks_or_budget",
    "semantic_change": "L1_reapproves_within_original_delegation_and_reruns_required_checks",
    "may_lower_acceptance_standard": false,
    "outside_delegation": "L1_submits_blocked_final_report_no_automatic_expansion"
  },
  "delivery": {
    "execute_when_existing_authorization_covers_actual_action": true,
    "check_actual_candidate_evidence_action_target": true,
    "require_new_approval_when_scope_not_covered": true,
    "DOT_may_self_authorize": false,
    "preauthorization_must_bind": [
      "actions",
      "targets",
      "candidate_conditions",
      "evidence_conditions",
      "expiry",
      "use_limit"
    ],
    "requires_approved_success_report": true,
    "preauthorization_may_bypass_report_review": false,
    "local_runtime_executes_delivery": false,
    "delivered_requires_external_receipt": true
  },
  "three_checkpoints": [
    "approved_requirements",
    "approved_execution_plan",
    "approved_final_report"
  ],
  "user_decision_triggers": [
    "initial_missing_facts",
    "final_report"
  ],
  "user_visible_outputs": [
    "initial_requirements_questions",
    "success_or_failure_final_report_for_review"
  ],
  "states": [
    {
      "id": "DISCOVERY",
      "next": [
        "REVIEW_PENDING"
      ],
      "guard": "L1 gathers facts and writes requirements; no product implementation"
    },
    {
      "id": "REVIEW_PENDING",
      "next": [
        "DISCOVERY",
        "PLAN_PENDING",
        "BLOCKED",
        "DECISION_PENDING",
        "REPORT_PENDING"
      ],
      "guard": "L1 delegated approval bound to original input, envelope, exact artifact and independent review; failure reflows to L1 or final report"
    },
    {
      "id": "PLAN_PENDING",
      "next": [
        "REVIEW_PENDING",
        "EXECUTING",
        "BLOCKED",
        "DECISION_PENDING",
        "REPORT_PENDING"
      ],
      "guard": "L1 delegated approval bound to original input, envelope, exact artifact and independent review; failure reflows to L1 or final report"
    },
    {
      "id": "EXECUTING",
      "next": [
        "VERIFYING",
        "DECISION_PENDING",
        "REPORT_PENDING",
        "BLOCKED"
      ],
      "guard": "Current requirements and plan approvals valid; dispatch within scope and cumulative budgets; failure or exhaustion produces report"
    },
    {
      "id": "VERIFYING",
      "next": [
        "EXECUTING",
        "DECISION_PENDING",
        "REPORT_PENDING",
        "BLOCKED"
      ],
      "guard": "Distinct developer tester reviewer sessions; immutable candidate and all required evidence; failures return DOT triage before bounded repair"
    },
    {
      "id": "DECISION_PENDING",
      "next": [
        "REVIEW_PENDING",
        "PLAN_PENDING",
        "EXECUTING",
        "VERIFYING",
        "REPORT_PENDING",
        "BLOCKED"
      ],
      "guard": "L1 handles requirements/verification/plan revision within immutable delegation; reapprove affected baselines, preserve counters; unresolved or outside scope produces final report"
    },
    {
      "id": "BLOCKED",
      "next": [
        "REVIEW_PENDING",
        "PLAN_PENDING",
        "REPORT_PENDING"
      ],
      "guard": "No automatic resumption; reconcile old runs and side effects; changed scope or additional budget needs new approval; counters never reset"
    },
    {
      "id": "REPORT_PENDING",
      "next": [
        "DELIVERY_READY",
        "BLOCKED"
      ],
      "guard": "L1 submits exact DOT outcome/evidence and its assessment; only human approves final report; failed/unknown remains BLOCKED and never authorizes retries"
    },
    {
      "id": "DELIVERY_READY",
      "next": [
        "DELIVERED",
        "DECISION_PENDING",
        "BLOCKED"
      ],
      "guard": "Approved success report plus exact action and target authorization and external receipt required for DELIVERED; local runtime cannot deliver"
    },
    {
      "id": "DELIVERED",
      "next": [
        "DISCOVERY"
      ],
      "guard": "New request preserves prior reports approvals evidence and cumulative history"
    }
  ],
  "advanced_reference": "docs/advanced-profile.md",
  "existing_project_protections_remain_required": true,
  "runtime_implemented_by_this_repository": true,
  "applicable_coding_standards": [
    "policy/embedded-c.json"
  ],
  "coding_standard_requires_extra_user_document": false,
  "execution_plan_requires_user_approval": false,
  "final_report_requires_user_approval": true,
  "requirements_approval_allows_implementation": false,
  "independent_review_required": true,
  "distinct_worker_sessions": [
    "developer",
    "tester",
    "reviewer"
  ],
  "runtime_approval_trust_model": "local_delegated_l1_and_final_human_no_authenticated_service",
  "agent_may_enter_user_approval": false,
  "failed_report_approval_resumes_execution": false,
  "budgets_reset_on_restart_or_replan": false,
  "requirements_require_l1_approval": true,
  "execution_plan_requires_l1_approval": true,
  "product_or_ac_change_requires_l1_decision": true,
  "default_approval_mode": "delegated_l1",
  "approval_owners": {
    "requirements": "L1",
    "execution_plan": "L1",
    "final_report": "user"
  },
  "communication_policy": "policy/communication.json"
}
