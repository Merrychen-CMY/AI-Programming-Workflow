{
  "schema_version": 1,
  "guide": "docs/guides/normal-start.md",
  "source_packet_owner": "controller",
  "source_packet_digest_bound": true,
  "existing_record_copy_consumes_revision": false,
  "new_facts_and_baseline_changes_retain_existing_limits": true,
  "approval_order": [
    "requirements",
    "plan",
    "execution"
  ],
  "wrong_phase_result": "COMPLETED_REJECTED",
  "wrong_phase_dispatches_worker_or_api": false,
  "wrong_phase_changes_authority_or_usage": false,
  "latest_review_before_history": true,
  "record_tool": "dot_read_record",
  "record_page_characters": 6000,
  "record_read_clears_unknown": false,
  "reopen_final_report": false,
  "retain_full_report_and_original_hash": true,
  "initial_native_order": [
    "prepare_requirements",
    "independent_requirements_review",
    "l1_requirements_approval",
    "dot_plan",
    "dot_initialize",
    "independent_plan_review",
    "l1_plan_approval",
    "execution"
  ],
  "preplan_reviews_counted_and_imported": true,
  "markdown_reports": {
    "stages": [
      "requirements_review",
      "execution_plan_review",
      "final_success_or_failure_including_preflight"
    ],
    "format": "markdown",
    "metadata_field": "report_files",
    "original_json_retained": true,
    "immutable_content_addressed_files": true,
    "new_report_returned_once_per_operation": true,
    "chat_delivery": "host_deliverables_presented_event",
    "host_bootstrap_abi": 8,
    "final_confirmation_checks_markdown_digest": true,
    "adds_user_approval_checkpoint": false,
    "delivery_failure_replays_review_or_execution": false
  }
}
