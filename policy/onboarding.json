{
  "schema_version": 1,
  "workflow_version": "3.23.4",
  "host": "DeepSeek Harness",
  "verified_source_version": "0.2.2-rc.3",
  "verified_source_commit": "6b729fedde0c8fd03af7afdf5a711aa64fe87c3b",
  "preset": "ai-programming-l1",
  "human_start_confirmation": "once_after_discovery_before_DOT_calls",
  "confirmation_provider": "native_ctx.userQuestions",
  "model_can_supply_human_confirmation": false,
  "routine_intermediate_approval_owner": "L1_after_independent_review",
  "final_report_review_owner": "user",
  "external_delivery_executor": false,
  "required_topics": [
    "requirements",
    "baseline",
    "scope",
    "functions",
    "acceptance",
    "test_environment",
    "test_plan",
    "delivery",
    "safety"
  ],
  "credential_ref": "AI_WORKFLOW_OPENAI_API_KEY",
  "credential_input": "local_setup_page_to_Harness_credential_provider",
  "credential_in_model_arguments": false,
  "credential_in_worker_environment": false,
  "api_endpoint": "https://api.openai.com/v1/responses",
  "setup_probe": {
    "explicit_user_button": true,
    "calls": 2,
    "synthetic_inputs_only": true,
    "product_evidence": false
  },
  "states_before_runtime": [
    "DISCOVERY",
    "PREPARED",
    "START_CONFIRMED",
    "NEEDS_INFO",
    "PLAN_REJECTED",
    "REQUIREMENTS_PENDING",
    "REQUIREMENTS_APPROVED",
    "DECISION_PENDING"
  ],
  "invalidation": [
    "draft_change",
    "model_or_executor_change",
    "project_baseline_change",
    "required_environment_change"
  ],
  "interruption": "persist_UNKNOWN_before_dispatch_no_automatic_replay",
  "security_boundary": "local_same_account_not_authenticated_approval_service",
  "base_environment_before_requirements": true,
  "ordered_stages": [
    "configure_model_and_key",
    "check_environment",
    "discuss_raw_requirements",
    "confirm_start",
    "l1_autonomous_execution",
    "user_final_report_review"
  ],
  "setup_diagnostics": "allowlisted_code_stage_http_status_no_raw_errors",
  "planning_policy": "policy/planning.json",
  "clarification_policy": {
    "state": "NEEDS_INFO",
    "append_tool": "l1_add_facts",
    "original_confirmation_immutable": true,
    "same_task_supplements_allowed": true,
    "budget_reset_allowed": false,
    "expiry_extension_allowed": false,
    "requires_independent_baseline_review": true,
    "unknown_or_final_report_auto_resume": false,
    "guide": "docs/guides/clarifications.md"
  },
  "resource_policy": "policy/resources.json",
  "update_policy": "policy/updates.json",
  "task_upgrade_policy": "policy/task-upgrades.json",
  "initialization_recovery_policy": "policy/initialization-recovery.json",
  "api_recovery_policy": "policy/api-recovery.json",
  "review_handoff_policy": "policy/review-handoff.json",
  "requirements_approval_before_initial_dot_plan": true,
  "new_native_tasks_require_adaptive_limits": true,
  "flow_recovery_policy": "policy/flow-recovery.json",
  "execution_scope_policy": "policy/execution-scope.json",
  "agent_capability_policy": "policy/agent-capabilities.json",
  "file_environment_policy": "policy/file-environment.json",
  "authentication": {
    "modes": [
      "chatgpt",
      "api_key"
    ],
    "default_new_install": "chatgpt",
    "legacy_config_default": "api_key",
    "automatic_paid_fallback": false,
    "task_pins_source_and_identity": true,
    "guide": "docs/guides/chatgpt-login.md"
  }
}
