{
  "schema_version": 1,
  "policy_version": "3.13.0",
  "status": "reference_specification",
  "execution_authority": false,
  "description": "L1唯一用户入口、代理中间审批；GPT/DOT承担L2/L5，所有回流先经L2。用户只审核最终报告。",
  "roles": [
    "L1",
    "L1-V",
    "L2",
    "L3",
    "L4",
    "L5"
  ],
  "forward_flow": [
    "L1",
    "independent_requirements_review",
    "L1_delegated_requirements_approval",
    "GPT_DOT_plan",
    "independent_plan_review",
    "L1_delegated_plan_approval",
    "G1",
    "L3",
    "G2",
    "L1-V-candidate-binding",
    "V0",
    "L4-test",
    "L4-review",
    "G3",
    "L5",
    "L1_final_report_submission",
    "user_final_report_review",
    "G4",
    "delivery_guard"
  ],
  "baseline_flow": {
    "before_G1": [
      "Product L1",
      "L1-V-plan"
    ],
    "after_G2": [
      "L1-V-candidate-binding",
      "V0"
    ]
  },
  "reflow": {
    "sources": [
      "L4",
      "L5"
    ],
    "intake_owner": "L2",
    "triage_owner": "L2",
    "require_issue_id": true,
    "require_evidence_before_classification": true,
    "allow_direct_l4_l5_to_l3": false,
    "routes": {
      "implementation": {
        "owner": "L3",
        "action": "L2传递原失败、完整方案、验证步骤、资源及权限边界，派L3修复；新候选独立重验"
      },
      "product_requirement": {
        "owner": "L1",
        "action": "L2 提交产品需求或 AC 决策；更新受影响基线及批准"
      },
      "task_plan_or_design": {
        "owner": "L2",
        "action": "重新拆解、协调方案和依赖；必要时再派 L3"
      },
      "verification_plan_or_test": {
        "owner": "L1-V",
        "action": "修订计划、用例、预期或验证器逻辑；独立维护并重新授权"
      },
      "test_infrastructure": {
        "owner": "L4",
        "action": "L2选择计划中已批准的本地设施动作交L4；缺方案或权限交L1；恢复后完整重验"
      },
      "evidence_collection": {
        "owner": "L4",
        "action": "核验原件及来源；不可恢复的证据须重新产生"
      },
      "delivery_target_or_authorization": {
        "owner": "L5",
        "action": "核对目标及动作，准备重新审批；L5不授予授权"
      },
      "security": {
        "owner": "authorized_security_owner",
        "action": "阻断并人工审查；L2协调，按根因另派修复"
      },
      "mixed": {
        "owner": "L2",
        "action": "拆关联子单；上游基线先决，分别分派并独立核验"
      },
      "needs_analysis": {
        "owner": "L2",
        "action": "保留调查待办；缺事实、权限或资源交L1协调；不得因尚未查明原因自动结案"
      }
    }
  },
  "candidate_rules": {
    "immutable": true,
    "new_id_on": [
      "product_code",
      "dependencies",
      "toolchain",
      "build_configuration",
      "artifacts",
      "integration_base"
    ],
    "reuse_pass_across_candidates": false,
    "plan_or_verifier_semantic_change": "new_approval_and_rerun_all_required_checks",
    "infrastructure_only": "same_candidate_possible_with_documented_impact_and_new_run_id"
  },
  "approval_rules": {
    "G1": "L1_delegated_requirements_and_plan_approval_with_independent_review",
    "V0": "validate_candidate_package_against_explicit_authorization",
    "G4": "user_approved_success_report_then_exact_action_target_authorization_and_real_receipt",
    "L5_can_approve_delivery": false,
    "merge_implies_release": false,
    "example_is_authorization": false,
    "simple_mode": "L1_approves_intermediate_baselines_user_reviews_final_report",
    "formal_gate_contract_scope": "when_formal_approval_and_gate_services_are_adopted",
    "delegated_plan_maintenance": "L1_reapproves_affected_baselines_within_current_user_authority_resource_allocation_is_separate"
  },
  "closure": {
    "implementation_or_verification": "independent_L4_reverification_and_trusted_verdict_then_L2_close",
    "delivery_only": "approval_service_and_delivery_guard_validation_L5_review_then_L2_close",
    "G3_requires_issue_CLOSED": false,
    "preserve_all_attempts": true
  },
  "budgets": {
    "implementation_attempts_including_initial": 3,
    "same_root_cause_failures_before_escalation": 2,
    "infrastructure_retries_excluding_initial": 2,
    "max_parallel_tasks_initial": 1,
    "task_timeout_minutes_example": 45,
    "evidence_max_age_hours_example": 24,
    "max_hil_minutes_example": 30,
    "reset_on_restart": false
  },
  "conflict_action": "BLOCKED_and_report_to_L2_or_user_no_silent_override",
  "project_adoption": "requires_explicit_user_assignment_scope_and_project_baselines",
  "default_user_flow": "policy/simple-flow.json",
  "user_interface": {
    "L1": "sole_user_interface_and_delegated_approver",
    "DOT": [
      "L2",
      "L5"
    ],
    "six_separate_conversations_required": false,
    "review_artifacts": [
      "L1_final_report"
    ]
  },
  "coding_standards": [
    "policy/embedded-c.json"
  ],
  "communication_policy": "policy/communication.json",
  "onboarding_policy": "policy/onboarding.json",
  "planning_policy": "policy/planning.json",
  "clarification_policy": {
    "state": "NEEDS_INFO",
    "append_tool": "l1_add_facts",
    "original_confirmation_immutable": true,
    "same_task_supplements_allowed": true,
    "budget_reset_allowed": false,
    "expiry_extension_allowed": false,
    "requires_independent_baseline_review": true,
    "unknown_or_final_report_auto_resume": false,
    "guide": "docs/guides/clarifications.md"
  },
  "resource_policy": "policy/resources.json",
  "budgets_scope": "Legacy fixed examples; adaptive task ceilings and current allocations are governed by policy/resources.json",
  "update_policy": "policy/updates.json",
  "task_upgrade_policy": "policy/task-upgrades.json",
  "initialization_recovery_policy": "policy/initialization-recovery.json",
  "api_recovery_policy": "policy/api-recovery.json",
  "review_handoff_policy": "policy/review-handoff.json",
  "input_material_policy": "policy/input-material.json",
  "non_success_closure": {
    "schema_version": 1,
    "non_success_requires_explicit_l1_assessment": true,
    "l2_may_finalize_failure": false,
    "l2_first_considers_in_scope_solutions": true,
    "insufficient_evidence_is_terminal": false,
    "out_of_scope_proposal_owner": "L1",
    "automatic_non_success_route": "L1_assessment",
    "assessment_template": "templates/l1-closure.example.json",
    "guide": "docs/guides/l1-closure.md"
  },
  "flow_recovery_policy": "policy/flow-recovery.json",
  "execution_scope_policy": "policy/execution-scope.json",
  "candidate_verification": {
    "guide": "docs/guides/verification-contract.md",
    "require_test_contract": true,
    "require_actual_product_provenance": true,
    "required_test_skip_passes": false,
    "independent_test_artifacts": "isolated_writable_copy_with_immutable_inputs",
    "facility_actions": "L2_selects_baseline_approved_actions_or_requests_L1_review"
  }
}
