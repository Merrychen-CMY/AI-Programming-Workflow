    "check_profiles": [
      "quick",
      "full",
      "hil",
      "soak"
    ],
    "all_profiles_required_for_every_task": false
  },
  "verification": {
    "host_behavior_links_real_C": true,
    "oracle_independent_of_current_output": true,
