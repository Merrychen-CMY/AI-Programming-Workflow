  },
  "readability": {
    "review_triggers": {
      "nesting_greater_than": 3,
      "condition_atoms_greater_than": 3,
      "mixed_and_or": true,
      "function_nonblank_noncomment_lines_greater_than": 50
    },
    "review_triggers_are_hard_limits": false,
    "trigger_requires_recorded_review": true,
    "mechanical_split_counts_as_fix": false,
    "preserve_short_circuit_MMIO_atomicity_cleanup": true,
    "new_function_constraints": {
      "max_nonblank_noncomment_lines": 50,
      "max_nesting_depth": 4,
      "source_rules": [
        "2.1",
        "2.2"
      ],
      "exception_requires_record_and_authorized_review": true,
      "routine_review_note_is_exception_approval": false,
      "automatically_rewrite_legacy_code": false
    }
  },
  "risk": {
    "levels": [
